# ============================================================================
# MarketMaster — Environment Configuration
# ============================================================================

# Application
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://marketmaster:marketmaster@localhost:5432/marketmaster
DATABASE_URL_SYNC=postgresql+psycopg://marketmaster:marketmaster@localhost:5432/marketmaster

# Redis
REDIS_URL=redis://localhost:6379/0

# Alpaca (Market Data + Paper Trading)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_PAPER=true
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_PAPER_TRADING_URL=https://paper-api.alpaca.markets

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=your_fred_api_key

# SEC EDGAR (required User-Agent: "Company Name email@example.com")
SEC_USER_AGENT=MarketMaster admin@example.com

# AI Provider (for agent reasoning layer)
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key
AI_MODEL=gpt-4o

# Trading Controls — LIVE TRADING DISABLED BY DEFAULT
ENABLE_LIVE_TRADING=false

# Risk Parameters
MAX_POSITION_RISK_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_PORTFOLIO_RISK_PCT=0.10
MAX_SECTOR_EXPOSURE_PCT=0.30
MAX_SINGLE_POSITION_PCT=0.10

# Data Ingestion
INGESTION_BATCH_SIZE=1000
INGESTION_RATE_LIMIT_RPS=10
